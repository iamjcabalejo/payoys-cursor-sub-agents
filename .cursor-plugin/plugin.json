{
  "name": "payoys-cursor-sub-agents",
  "version": "3.2.1",
  "description": "17 commands, 19 agents, 20 skills, 7 rules, and hooks for Plan → Code → Review/Test workflow (Next.js, Supabase, TypeScript)",
  "author": {
    "name": "Jhon Cabalejo",
    "email": "iamjcabalejo@gmail.com"
  },
  "license": "MIT",
  "keywords": [
    "productivity",
    "nextjs",
    "supabase",
    "typescript",
    "react",
    "api",
    "development",
    "mcp"
  ],
  "rules": ".cursor/rules/",
  "agents": ".cursor/agents/",
  "skills": ".cursor/skills/",
  "commands": ".cursor/commands/",
  "hooks": ".cursor/hooks.json",
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "description": "Access up-to-date documentation for any library"
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "description": "Browser automation and web testing capabilities"
    },
    "supabase": {
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server-supabase"],
      "description": "Supabase database operations and management"
    }
  }
}
